# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/babylog

# Authentication (Supabase)
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Environment (development, staging, prod)
ENVIRONMENT=development

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Stripe (premium features)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Web Push (VAPID keys - generate at https://web-push-codelab.glitch.me/)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=support@heybub.app

# Photo Storage
PHOTO_BUCKET=photos

# Admin
ADMIN_API_KEY=

# Telegram Bot (Phase 3)
TELEGRAM_BOT_TOKEN=
