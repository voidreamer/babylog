# =============================================================
# HeyBub Backend — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# =============================================================

# ── Required ─────────────────────────────────────────────────
# App won't work without these

DATABASE_URL=postgresql://user:pass@localhost:5432/babylog
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Environment ──────────────────────────────────────────────

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Voice (optional) ────────────────────────────────────────
# Groq is free at console.groq.com — powers voice command parsing

GROQ_API_KEY=

# ── Payments (optional) ─────────────────────────────────────
# Only needed if enabling premium subscriptions

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ── Monitoring (optional) ───────────────────────────────────

SENTRY_DSN=

# ── Admin (optional) ────────────────────────────────────────
# Protects admin endpoints (migrations, etc.) in production

ADMIN_API_KEY=

# ── Push Notifications (optional, not yet active) ───────────
# Generate VAPID keys at https://web-push-codelab.glitch.me/

VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=support@heybub.app

# ── Telegram Bot (optional, not yet active) ─────────────────

TELEGRAM_BOT_TOKEN=
