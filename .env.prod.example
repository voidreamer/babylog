# HeyBub Production Environment Variables
# Copy to .env.prod and fill in values

# Database
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Environment
ENVIRONMENT=prod

# Auth
SUPABASE_JWT_SECRET=

# CORS (comma-separated origins)
CORS_ORIGINS=https://app.heybub.app,capacitor://localhost

# Admin
ADMIN_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Web Push (VAPID)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=support@heybub.app

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PHOTO_BUCKET=photos
