{
  "appId": "com.simplebaby.app",
  "appName": "Simple Baby",
  "webDir": "dist",
  "server": {
    "allowNavigation": [
      "*.cloudfront.net",
      "*.amazonaws.com",
      "*.amazoncognito.com"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "backgroundColor": "#18181b",
    "scheme": "simplebaby"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#18181b",
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null
    }
  },
  "plugins": {
    "Browser": {
      "presentationStyle": "popover"
    }
  }
}