{
  "appId": "com.heybub.app",
  "appName": "HeyBub",
  "webDir": "dist",
  "server": {
    "allowNavigation": [
      "*.cloudfront.net",
      "*.amazonaws.com",
      "*.supabase.co",
      "*.supabase.com"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "backgroundColor": "#18181b"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#18181b",
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null
    }
  },
  "plugins": {
    "Browser": {
      "presentationStyle": "popover"
    },
    "Camera": {
      "presentationStyle": "fullscreen"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}