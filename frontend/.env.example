# =============================================================
# HeyBub Frontend — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# =============================================================

# ── Required ─────────────────────────────────────────────────
# App won't work without these

VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Voice (optional) ────────────────────────────────────────
# Falls back gracefully: ElevenLabs → Deepgram → browser speech

VITE_ELEVENLABS_API_KEY=
VITE_DEEPGRAM_API_KEY=

# ── Payments (optional) ─────────────────────────────────────
# Only needed if enabling premium subscriptions

VITE_STRIPE_PRICE_MONTHLY=
VITE_STRIPE_PRICE_YEARLY=

# ── Monitoring (optional) ───────────────────────────────────
# Disabled when empty

VITE_SENTRY_DSN=
VITE_MIXPANEL_TOKEN=
