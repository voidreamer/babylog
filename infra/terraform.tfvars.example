# Terraform Variable Values
# Copy this file to terraform.tfvars and fill in values

# Environment (prod or staging)
environment = "prod"

# Supabase PostgreSQL connection URL
database_url = "postgresql://user:password@host:6543/postgres"

# Supabase JWT Secret (from Supabase Dashboard > Settings > API)
supabase_jwt_secret = "your-jwt-secret-here"

# CORS origins are set in variables.tf (not sensitive, committed to repo)
# Override here only if you need different origins for local testing

# Admin API key for protected endpoints
admin_api_key = ""

# ============================================================================
# Oracle Cloud — the live production host (Always-Free Ampere A1).
# Auth comes from the API-key profile in ~/.oci/config (default: HEYBUB);
# tenancy/compartment/region default to the heybub tenancy in variables.tf.
# ============================================================================
# oci_config_profile = "HEYBUB"
# oci_region         = "ca-toronto-1"
# ssh_public_key     = "ssh-ed25519 AAAA... you@host"   # injected into the opc user
# oci_ocpus          = 2     # Always-Free Ampere pool allows up to 4
# oci_memory_gb      = 16    # ...and up to 24 GB total

# ============================================================================
# AWS — dormant by default (free tier ended; stack preserved for DR / a fresh
# account). Flip to true ONLY against a clean AWS account, then `terraform apply`.
# ============================================================================
# enable_aws = false
